generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  MEMBER
}

enum PlatformRole {
  USER
  ADMIN
}

enum BookableStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PricingType {
  FREE
  PAID
}

enum BookableCapacityType {
  RESOURCE
  EVENT
}

enum DurationMode {
  FLEXIBLE
  FIXED
}

enum ConfirmationPolicy {
  AUTOMATIC
  REQUIRES_APPROVAL
}

enum AvailabilityWindowType {
  RECURRING
  SPECIFIC
}

enum AvailabilityExceptionType {
  BLOCK
  OVERRIDE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  EXPIRED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  PAYSTACK
}

enum OrganizationPaymentAccountStatus {
  ONBOARDING
  READY
  RESTRICTED
  DISCONNECTED
}

enum AccessCodeStatus {
  ACTIVE
  USED
  EXPIRED
  REVOKED
}

model User {
  id                   String                @id @default(uuid()) @db.Uuid
  email                String                @unique @db.VarChar(320)
  passwordHash         String                @db.VarChar(255)
  name                 String                @db.VarChar(200)
  platformRole         PlatformRole         @default(USER)
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)
  memberships          OrganizationMembership[]
  reservations         Reservation[]         @relation("ReservationCustomer")
  refreshSessions      RefreshSession[]
  idempotencyRecords   IdempotencyRecord[]
}

model Organization {
  id            String                   @id @default(uuid()) @db.Uuid
  name          String                   @db.VarChar(200)
  slug          String                   @unique @db.VarChar(120)
  timezone      String                   @default("Africa/Lagos") @db.VarChar(100)
  createdAt     DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime                 @updatedAt @db.Timestamptz(3)
  memberships   OrganizationMembership[]
  bookables     Bookable[]
  bookableImages BookableImage[]
  paymentAccount OrganizationPaymentAccount?
}

model OrganizationPaymentAccount {
  id                String                           @id @default(uuid()) @db.Uuid
  organizationId    String                           @unique @db.Uuid
  provider          PaymentProvider
  providerAccountId String                           @db.VarChar(255)
  status            OrganizationPaymentAccountStatus @default(ONBOARDING)
  readyForPayments  Boolean                          @default(false)
  createdAt         DateTime                         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                         @updatedAt @db.Timestamptz(3)
  lastSyncedAt      DateTime?
  connectedAt       DateTime?
  disconnectedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([organizationId, status])
}

model OrganizationMembership {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  organizationId String       @db.Uuid
  role           MembershipRole
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model Bookable {
  id                String                    @id @default(uuid()) @db.Uuid
  organizationId    String                    @db.Uuid
  name              String                    @db.VarChar(200)
  description       String?
  slug              String                    @unique @db.VarChar(160)
  status            BookableStatus             @default(DRAFT)
  pricingType       PricingType
  confirmationPolicy ConfirmationPolicy       @default(AUTOMATIC)
  capacityType      BookableCapacityType      @default(RESOURCE)
  capacity          Int
  price             Int?
  currency          String?                   @db.Char(3)
  createdAt         DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                  @updatedAt @db.Timestamptz(3)
  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  reservationRule   BookableReservationRule?
  availability      AvailabilityWindow[]
  exceptions        AvailabilityException[]
  reservations      Reservation[]
  images            BookableImage[]

  @@index([organizationId, status])
}

model BookableImage {
  id               String      @id @default(uuid()) @db.Uuid
  bookableId       String      @db.Uuid
  organizationId   String      @db.Uuid
  provider         String      @db.VarChar(40)
  providerKey      String      @db.VarChar(255)
  url              String      @db.Text
  originalFilename String?     @db.VarChar(255)
  mimeType         String      @db.VarChar(80)
  fileSizeBytes    Int         @db.Integer
  width            Int?
  height           Int?
  sortOrder        Int
  isPrimary        Boolean     @default(false)
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @db.Timestamptz(3)

  bookable     Bookable    @relation(fields: [bookableId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([bookableId, sortOrder])
  @@unique([provider, providerKey])
  @@index([bookableId])
  @@index([organizationId])
}

model BookableReservationRule {
  id                   String    @id @default(uuid()) @db.Uuid
  bookableId           String    @unique @db.Uuid
  durationMode         DurationMode
  minimumDuration      Int?
  maximumDuration      Int?
  fixedDuration        Int?
  minimumAdvanceTime   Int?
  maximumAdvanceTime   Int?
  cancellationDeadline Int?
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)
  bookable             Bookable  @relation(fields: [bookableId], references: [id], onDelete: Cascade)
}

model AvailabilityWindow {
  id         String                  @id @default(uuid()) @db.Uuid
  bookableId String                  @db.Uuid
  type       AvailabilityWindowType
  weekday    Int?
  startTime  String?                 @db.VarChar(5)
  endTime    String?                 @db.VarChar(5)
  startAt    DateTime?               @db.Timestamptz(3)
  endAt      DateTime?               @db.Timestamptz(3)
  createdAt  DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime                @updatedAt @db.Timestamptz(3)
  bookable   Bookable                @relation(fields: [bookableId], references: [id], onDelete: Cascade)

  @@index([bookableId, type, weekday])
  @@index([bookableId, startAt, endAt])
}

model AvailabilityException {
  id         String                     @id @default(uuid()) @db.Uuid
  bookableId String                     @db.Uuid
  type       AvailabilityExceptionType
  startAt    DateTime                   @db.Timestamptz(3)
  endAt      DateTime                   @db.Timestamptz(3)
  createdAt  DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime                   @updatedAt @db.Timestamptz(3)
  bookable   Bookable                   @relation(fields: [bookableId], references: [id], onDelete: Cascade)

  @@index([bookableId, startAt, endAt])
}

model Reservation {
  id         String            @id @default(uuid()) @db.Uuid
  bookableId String            @db.Uuid
  customerId String            @db.Uuid
  startAt    DateTime          @db.Timestamptz(3)
  endAt      DateTime          @db.Timestamptz(3)
  quantity   Int
  amount     Int               @default(0)
  currency   String            @default("NGN") @db.Char(3)
  status     ReservationStatus @default(PENDING)
  approvedAt DateTime?         @db.Timestamptz(3)
  expiresAt  DateTime?         @db.Timestamptz(3)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @db.Timestamptz(3)
  bookable   Bookable          @relation(fields: [bookableId], references: [id], onDelete: Restrict)
  customer   User              @relation("ReservationCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  payment    Payment?
  accessCodes AccessCode[]

  @@index([bookableId, startAt, endAt])
  @@index([customerId, status])
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  reservationId     String        @unique @db.Uuid
  provider          String        @db.VarChar(80)
  providerReference String        @db.VarChar(255)
  amount            Int
  currency          String        @db.Char(3)
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?     @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)
  reservation       Reservation   @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@unique([provider, providerReference])
}

model AccessCode {
  id            String            @id @default(uuid()) @db.Uuid
  reservationId String            @db.Uuid
  codeHash      String            @db.VarChar(255)
  status        AccessCodeStatus  @default(ACTIVE)
  expiresAt     DateTime?         @db.Timestamptz(3)
  usedAt        DateTime?         @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)
  reservation   Reservation       @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@index([reservationId, status])
  @@index([status, expiresAt])
}

model RefreshSession {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  tokenHash  String   @db.VarChar(255)
  expiresAt  DateTime @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model IdempotencyRecord {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  key        String   @db.VarChar(255)
  operation  String   @db.VarChar(120)
  requestHash String  @db.VarChar(128)
  status     String   @db.VarChar(40)
  response   Json
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, operation, key])
  @@index([userId, expiresAt])
}
